{
	"name": "monster-hotel",
	"globIgnorePaths": [
		"**/*.tmp",
		"**/*.tmp.*"
	],
	"tree": {
		"$className": "DataModel",
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"StreamingEnabled": true
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": "src/server"
			},
			"ServerPackages": {
				"$path": {
					"optional": "ServerPackages"
				}
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"HotelKit": {
				"$className": "Folder",
				"HauntedManor": {
					"$path": {
						"optional": "assets/HotelKit/HauntedManor"
					}
				},
				"FrostfangLodge": {
					"$path": {
						"optional": "assets/HotelKit/FrostfangLodge"
					}
				}
			},
			"Cosmetics": {
				"$path": {
					"optional": "assets/Cosmetics"
				}
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Shared": {
				"$path": "src/shared"
			},
			"Monsters": {
				"$path": {
					"optional": "assets/Monsters"
				}
			},
			"Scenery": {
				"$path": {
					"optional": "assets/Scenery"
				}
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "src/client"
				}
			}
		}
	}
}
