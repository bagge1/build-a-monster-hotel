# Roblox Studio lock files
*.rbxl.lock
*.rbxlx.lock
*.rbxm.lock

# The place lives published, not on disk. A local copy has no PlaceId, which
# silently turns every persistence test into a lie (DEVNOTES.md, "Data").
/*.rbxl

# Rojo build output; the throwaway place built to inspect what Rojo produces
/build/
/check.rbxlx

# Wally packages (restored from wally.lock)
/Packages/
/ServerPackages/
/DevPackages/

# Generated by luau-lsp / selene
sourcemap.json
roblox.toml

# Python bytecode from tools/
__pycache__/

# The art sources stay on the machine that built them: a set's FBX is rebuilt
# by its tools/build_*.py, and what reaches the game is the import under
# assets/. Every set's README.md, manifest.json, validation.json and August's
# reference pictures ARE versioned, so a clone knows each set's state.
/blender/**/*.blend
/blender/**/*.blend1
/blender/**/*.fbx
/blender/**/*.exr
/blender/**/*.log
/blender/**/_import/
/blender/**/backup_*/
/blender/**/*.png
/blender/**/*.jpg
/blender/**/*.webp
!/blender/**/reference/*
!/blender/**/reference.png
!/blender/**/reference_*.*

# Generated test bundle (tools/test_bundle.py)
src/server/TestBundle.luau

# Secrets, never in git
.env
.DS_Store

# Session locks for Blender and Studio (LAUNCH.md, "How the work runs")
/.locks/
